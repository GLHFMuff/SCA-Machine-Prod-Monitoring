# ============================================================
# Database Configuration (PostgreSQL)
# ============================================================
# Silakan sesuaikan dengan IP Host, Port, Database, User, dan Password PostgreSQL Anda.

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_NAME=postgres

# Aktifkan SSL jika PostgreSQL membutuhkan koneksi aman (misal cloud DB): true / false
DB_SSL=false

# Connection Pool Settings (Opsional)
DB_POOL_MAX=10
DB_TIMEOUT_MS=5000

# ============================================================
# Server API Configuration
# ============================================================
PORT=5000
NODE_ENV=development

# ============================================================
# HTTPS & SSL Configuration
# ============================================================
# Paksa redirect HTTP ke HTTPS (jika di belakang reverse proxy Nginx/Cloudflare)
FORCE_HTTPS=false

# Aktifkan HTTPS langsung pada server Node.js Express (butuh sertifikat .key dan .crt)
ENABLE_HTTPS=false
# SSL_KEY_PATH=./server/ssl/server.key
# SSL_CERT_PATH=./server/ssl/server.crt
